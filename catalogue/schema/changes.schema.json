{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adinwalls/plugsalot/catalogue/schema/changes.schema.json",
  "title": "Plugsalot change list",
  "description": "What the LLM returns for a follow-up request: small edits against the current chain.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "changes", "explanation"],
  "properties": {
    "schema_version": { "const": 1 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "module_index", "param", "value"],
            "properties": {
              "op": { "const": "set" },
              "module_index": { "type": "integer", "minimum": 0 },
              "param": { "type": "string" },
              "value": {}
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "at", "module", "params"],
            "properties": {
              "op": { "const": "insert" },
              "at": { "type": "integer", "minimum": 0 },
              "module": { "type": "string" },
              "params": { "type": "object" }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "module_index"],
            "properties": {
              "op": { "const": "remove" },
              "module_index": { "type": "integer", "minimum": 0 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "from", "to"],
            "properties": {
              "op": { "const": "move" },
              "from": { "type": "integer", "minimum": 0 },
              "to": { "type": "integer", "minimum": 0 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["op", "module_index", "bypass"],
            "properties": {
              "op": { "const": "bypass" },
              "module_index": { "type": "integer", "minimum": 0 },
              "bypass": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "explanation": { "type": "string", "maxLength": 600 }
  }
}
