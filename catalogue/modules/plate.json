{
  "schema_version": 1,
  "id": "plate",
  "name": "Plate Reverb",
  "kind": "effect",
  "category": "reverb",
  "source": {
    "source_key": "dragonfly-reverb",
    "repo": "https://github.com/michaelwillis/dragonfly-reverb",
    "commit": "440ec7b3b3db2fec34b9f80cf4890102ca14d1c3",
    "path": "plugins/dragonfly-plate-reverb",
    "upstream_name": "Dragonfly Plate Reverb",
    "license": "GPL-3.0",
    "authors": "Michael Willis and contributors",
    "extractor": "dpf_param_table"
  },
  "purpose": "Plate reverb for bright, dense ambience; the classic choice for lead vocals and snare.",
  "good_for": [
    "lead vocal",
    "backing vocal",
    "snare",
    "acoustic guitar",
    "keys",
    "synth"
  ],
  "avoid_for": [
    "bass",
    "kick"
  ],
  "tags": [
    "ambience",
    "space",
    "plate",
    "vocal reverb"
  ],
  "cpu_points": 1,
  "cpu_measured": true,
  "latency": {
    "type": "none"
  },
  "tracking_safe": true,
  "channels": [
    "stereo"
  ],
  "maker": "Dragonfly",
  "tape": "SPACE AROUND IT",
  "knobs": [
    {
      "param": "decay",
      "label": "DECAY",
      "colour": "cream"
    },
    {
      "param": "predelay",
      "label": "PRE-DLY",
      "colour": "cream"
    },
    {
      "param": "width",
      "label": "WIDTH",
      "colour": "cream"
    },
    {
      "param": "low_cut",
      "label": "LOW CUT",
      "colour": "black"
    },
    {
      "param": "wet",
      "label": "MIX",
      "colour": "cream"
    }
  ],
  "params": [
    {
      "id": "dry",
      "upstream_id": "dry_level",
      "name": "Dry Level",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 80.0,
      "unit": "%",
      "ai_hint": "Dry signal level. Keep at 100% when used as an insert; Plugsalot later moves reverbs to sends."
    },
    {
      "id": "wet",
      "upstream_id": "early_level",
      "name": "Wet Level",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 20.0,
      "unit": "%",
      "ai_hint": "Reverb level. 10-20% for a subtle vocal plate."
    },
    {
      "id": "algorithm",
      "upstream_id": "algorithm",
      "name": "Algorithm",
      "type": "enum",
      "default": "Nested",
      "options": [
        "Simple",
        "Nested",
        "Tank"
      ],
      "convert": "enum_index",
      "ai_hint": "Simple, Nested (default, smooth) or Tank (bigger, thicker)."
    },
    {
      "id": "width",
      "upstream_id": "width",
      "name": "Width",
      "type": "float",
      "min": 50.0,
      "max": 150.0,
      "default": 100,
      "unit": "%",
      "ai_hint": "Stereo width of the tail."
    },
    {
      "id": "predelay",
      "upstream_id": "predelay",
      "name": "Predelay",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 0.0,
      "unit": "ms",
      "ai_hint": "20-40 ms keeps a vocal clear in front of its reverb."
    },
    {
      "id": "decay",
      "upstream_id": "decay",
      "name": "Decay",
      "type": "float",
      "min": 0.1,
      "max": 10.0,
      "default": 0.4,
      "unit": "s",
      "ai_hint": "Tail length in seconds; 0.6-1.2 s for vocals at mid tempos."
    },
    {
      "id": "low_cut",
      "upstream_id": "low_cut",
      "name": "Low Cut",
      "type": "float",
      "min": 0.0,
      "max": 200.0,
      "default": 200,
      "unit": "Hz",
      "ai_hint": "Raise to 150-300 Hz to stop the reverb muddying the low mids."
    },
    {
      "id": "high_cut",
      "upstream_id": "high_cut",
      "name": "High Cut",
      "type": "float",
      "min": 1000.0,
      "max": 16000.0,
      "default": 16000,
      "unit": "Hz",
      "ai_hint": "Lower to darken the tail and reduce sibilant splash."
    },
    {
      "id": "damping",
      "upstream_id": "early_damp",
      "name": "Dampen",
      "type": "float",
      "min": 1000.0,
      "max": 16000.0,
      "default": 13000,
      "unit": "Hz",
      "ai_hint": "High-frequency damping of the tail."
    }
  ],
  "hidden_params": {
    "count": 0
  },
  "presets": [
    {
      "name": "Abrupt Plate",
      "params": {
        "dry": 80.0,
        "wet": 20.0,
        "algorithm": "Nested",
        "width": 100,
        "predelay": 20.0,
        "decay": 0.2,
        "low_cut": 50,
        "high_cut": 10000,
        "damping": 7000
      }
    },
    {
      "name": "Bright Plate",
      "params": {
        "dry": 80.0,
        "wet": 20.0,
        "algorithm": "Nested",
        "width": 100,
        "predelay": 0.0,
        "decay": 0.4,
        "low_cut": 200,
        "high_cut": 16000,
        "damping": 13000
      }
    },
    {
      "name": "Clear Plate",
      "params": {
        "dry": 80.0,
        "wet": 20.0,
        "algorithm": "Nested",
        "width": 100,
        "predelay": 0.0,
        "decay": 0.6,
        "low_cut": 100,
        "high_cut": 13000,
        "damping": 7000
      }
    },
    {
      "name": "Dark Plate",
      "params": {
        "dry": 80.0,
        "wet": 20.0,
        "algorithm": "Nested",
        "width": 100,
        "predelay": 0.0,
        "decay": 0.8,
        "low_cut": 50,
        "high_cut": 7000,
        "damping": 4000
      }
    },
    {
      "name": "Foil Tray",
      "params": {
        "dry": 80.0,
        "wet": 20.0,
        "algorithm": "Simple",
        "width": 50,
        "predelay": 0.0,
        "decay": 0.3,
        "low_cut": 200,
        "high_cut": 16000,
        "damping": 13000
      }
    },
    {
      "name": "Metal Roof",
      "params": {
        "dry": 80.0,
        "wet": 20.0,
        "algorithm": "Simple",
        "width": 120,
        "predelay": 20.0,
        "decay": 0.5,
        "low_cut": 100,
        "high_cut": 13000,
        "damping": 10000
      }
    },
    {
      "name": "Narrow Tank",
      "params": {
        "dry": 80.0,
        "wet": 20.0,
        "algorithm": "Tank",
        "width": 60,
        "predelay": 10.0,
        "decay": 0.6,
        "low_cut": 50,
        "high_cut": 10000,
        "damping": 7000
      }
    },
    {
      "name": "Phat Tank",
      "params": {
        "dry": 80.0,
        "wet": 20.0,
        "algorithm": "Tank",
        "width": 150,
        "predelay": 10.0,
        "decay": 1.0,
        "low_cut": 50,
        "high_cut": 10000,
        "damping": 4000
      }
    }
  ],
  "notes": [
    "Upstream symbol for wet level is 'early_level'; exposed here as 'wet'.",
    "Defaults come from the upstream default preset, Bright Plate.",
    "CPU: 0.43% of one core at 48 kHz on Plugsalot's 2-core build machine (plugin/tests/TestMain.cpp); 1 point per 2%, minimum 1."
  ]
}
