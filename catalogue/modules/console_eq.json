{
  "schema_version": 1,
  "id": "console_eq",
  "name": "Console EQ",
  "kind": "effect",
  "category": "eq",
  "source": {
    "source_key": "dusk-audio",
    "repo": "https://github.com/dusk-audio/dusk-audio-plugins",
    "commit": "e0991c57cac4f8f666b5749dcb90dcbd9081cd30",
    "path": "plugins/shared-daf/dsp/FourKEQDSP.cpp",
    "upstream_name": "Dusk Audio 4K EQ 2",
    "license": "GPL-3.0-or-later",
    "authors": "Dusk Audio",
    "extractor": "dusk_table"
  },
  "purpose": "British console-style channel EQ: high-pass and low-pass filters plus four bands (two shelving or bell, two sweepable mids) with musical, slightly coloured curves.",
  "good_for": [
    "lead vocal",
    "backing vocal",
    "acoustic guitar",
    "electric guitar",
    "bass",
    "kick",
    "snare",
    "full kit",
    "software drums",
    "synth",
    "keys",
    "bus",
    "master"
  ],
  "tags": [
    "corrective",
    "tonal",
    "console",
    "high-pass",
    "musical"
  ],
  "cpu_points": 1,
  "cpu_measured": true,
  "latency": {
    "type": "variable",
    "note": "Oversampling adds latency; at 1x it has none."
  },
  "tracking_safe": true,
  "tracking_overrides": {
    "oversampling": "1x"
  },
  "channels": [
    "mono",
    "stereo"
  ],
  "maker": "Dusk Audio",
  "tape": "TONE: CUT MUD, ADD AIR",
  "knobs": [
    {
      "param": "hpf_hz",
      "label": "HPF",
      "colour": "black"
    },
    {
      "param": "lf_gain",
      "label": "LOW",
      "colour": "blue"
    },
    {
      "param": "lm_gain",
      "label": "LO MID",
      "colour": "blue"
    },
    {
      "param": "hm_gain",
      "label": "HI MID",
      "colour": "blue"
    },
    {
      "param": "hf_gain",
      "label": "HIGH",
      "colour": "blue"
    }
  ],
  "params": [
    {
      "id": "eq_type",
      "upstream_id": "eq_type",
      "name": "Console type",
      "type": "enum",
      "default": "Brown",
      "options": [
        "Brown",
        "Black"
      ],
      "convert": "enum_index",
      "ai_hint": "Brown: broader, warmer E-series curves. Black: tighter G-series curves with proportional Q."
    },
    {
      "id": "hpf_enabled",
      "upstream_id": "hpf_enabled",
      "name": "High-pass on",
      "type": "bool",
      "default": false,
      "ai_hint": "On for almost every source except kick, bass and full mixes."
    },
    {
      "id": "hpf_hz",
      "upstream_id": "hpf_hz",
      "name": "High-pass frequency",
      "type": "float",
      "min": 16.0,
      "max": 350.0,
      "default": 16.0,
      "unit": "Hz",
      "ai_hint": "Just below the source's lowest useful note: vocals 80-120 Hz, acoustic guitar 80-100 Hz."
    },
    {
      "id": "lpf_enabled",
      "upstream_id": "lpf_enabled",
      "name": "Low-pass on",
      "type": "bool",
      "default": false,
      "ai_hint": "Usually off; use to tame fizz on distorted guitars or dull a harsh source."
    },
    {
      "id": "lpf_hz",
      "upstream_id": "lpf_hz",
      "name": "Low-pass frequency",
      "type": "float",
      "min": 3000.0,
      "max": 15201.0,
      "default": 15201.0,
      "unit": "Hz"
    },
    {
      "id": "lf_gain",
      "upstream_id": "lf_gain",
      "name": "Low band gain",
      "type": "float",
      "min": -12,
      "max": 12,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Low shelf (or bell). Small moves of 1-3 dB."
    },
    {
      "id": "lf_hz",
      "upstream_id": "lf_hz",
      "name": "Low band frequency",
      "type": "float",
      "min": 30.0,
      "max": 450.0,
      "default": 200.0,
      "unit": "Hz"
    },
    {
      "id": "lf_bell",
      "upstream_id": "lf_bell",
      "name": "Low band bell",
      "type": "bool",
      "default": false,
      "ai_hint": "Off = shelf, on = bell."
    },
    {
      "id": "lm_gain",
      "upstream_id": "lm_gain",
      "name": "Low-mid gain",
      "type": "float",
      "min": -12,
      "max": 12,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Mud lives at 200-500 Hz; cut 2-4 dB."
    },
    {
      "id": "lm_hz",
      "upstream_id": "lm_hz",
      "name": "Low-mid frequency",
      "type": "float",
      "min": 200.0,
      "max": 2500.0,
      "default": 1000.0,
      "unit": "Hz"
    },
    {
      "id": "lm_q",
      "upstream_id": "lm_q",
      "name": "Low-mid Q",
      "type": "float",
      "min": 0.5,
      "max": 3.0,
      "default": 1.5,
      "unit": "",
      "ai_hint": "0.5 broad to 3 narrow."
    },
    {
      "id": "hm_gain",
      "upstream_id": "hm_gain",
      "name": "High-mid gain",
      "type": "float",
      "min": -12,
      "max": 12,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Presence 2-5 kHz; harshness often 2.5-4 kHz."
    },
    {
      "id": "hm_hz",
      "upstream_id": "hm_hz",
      "name": "High-mid frequency",
      "type": "float",
      "min": 600.0,
      "max": 7000.0,
      "default": 3000.0,
      "unit": "Hz"
    },
    {
      "id": "hm_q",
      "upstream_id": "hm_q",
      "name": "High-mid Q",
      "type": "float",
      "min": 0.5,
      "max": 3.0,
      "default": 1.5,
      "unit": "",
      "ai_hint": "0.5 broad to 3 narrow."
    },
    {
      "id": "hf_gain",
      "upstream_id": "hf_gain",
      "name": "High band gain",
      "type": "float",
      "min": -12,
      "max": 12,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Air above 8-12 kHz; boosts here also lift sibilance."
    },
    {
      "id": "hf_hz",
      "upstream_id": "hf_hz",
      "name": "High band frequency",
      "type": "float",
      "min": 1500.0,
      "max": 16000.0,
      "default": 8000.0,
      "unit": "Hz"
    },
    {
      "id": "hf_bell",
      "upstream_id": "hf_bell",
      "name": "High band bell",
      "type": "bool",
      "default": false,
      "ai_hint": "Off = shelf, on = bell."
    },
    {
      "id": "input_gain",
      "upstream_id": "input_gain",
      "name": "Input gain",
      "type": "float",
      "min": -12.0,
      "max": 12.0,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Drives the modelled console path; leave at 0 unless colour is wanted."
    },
    {
      "id": "output_gain",
      "upstream_id": "output_gain",
      "name": "Output gain",
      "type": "float",
      "min": -12.0,
      "max": 12.0,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Match output level to input after boosts."
    },
    {
      "id": "oversampling",
      "upstream_id": "oversampling",
      "name": "oversampling",
      "type": "enum",
      "default": "4x",
      "options": [
        "1x",
        "2x",
        "4x"
      ],
      "convert": "enum_index",
      "ai_hint": "4x default for best sound. 1x when tracking."
    }
  ],
  "hidden_params": {
    "count": 3,
    "reason": "Mid/side mode, auto gain and the legacy dial-position controls stay at defaults; the Hz controls are used instead."
  },
  "notes": [
    "Embeds Dusk's framework-free FourKEQDSP core. Frequencies are set through the core's Hz setters, which take precedence over the legacy dial positions.",
    "Used as the prototype EQ while the LSP Parametric EQ port is pending.",
    "CPU: 1.27% of one core at 48 kHz on Plugsalot's 2-core build machine (plugin/tests/TestMain.cpp); 1 point per 2%, minimum 1."
  ]
}
