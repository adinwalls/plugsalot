  "params": [
    {
      "id": "mode",
      "upstream_id": "mode",
      "name": "Mode",
      "type": "enum",
      "default": "Opto",
      "options": [
        "Opto",
        "FET",
        "VCA",
        "Bus",
        "Studio FET",
        "Studio VCA",
        "Digital"
      ],
      "convert": "enum_index",
      "ai_hint": "Opto: smooth vocal levelling. FET: aggressive, forward vocals and drums. Bus: drum and mix glue. Studio modes: cleaner. Digital: precise. Set only the parameters of the chosen mode."
    },
    {
      "id": "mix",
      "upstream_id": "mix",
      "name": "Mix",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 100,
      "unit": "%",
      "ai_hint": "Below 100% for parallel compression."
    },
    {
      "id": "sidechain_hp",
      "upstream_id": "sidechain_hp",
      "name": "SC HP Filter",
      "type": "float",
      "min": 0,
      "max": 500,
      "default": 0,
      "unit": "Hz",
      "scale": "log",
      "ai_hint": "60-100 Hz stops low end from pumping the compressor; 0 = off."
    },
    {
      "id": "auto_makeup",
      "upstream_id": "auto_makeup",
      "name": "Auto Makeup",
      "type": "bool",
      "default": false,
      "ai_hint": "On to keep output level matched while adjusting compression."
    },
    {
      "id": "oversampling",
      "upstream_id": "oversampling",
      "name": "Oversampling",
      "type": "enum",
      "default": "2x",
      "options": [
        "Off",
        "2x",
        "4x"
      ],
      "convert": "enum_index",
      "ai_hint": "2x default. Off when tracking. 4x only on a final bus."
    },
    {
      "id": "opto_peak_reduction",
      "upstream_id": "opto_peak_reduction",
      "name": "Opto Peak Reduction",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 0,
      "unit": "%",
      "ai_hint": "Opto only. Compression amount; around 50 gives roughly 4-6 dB of reduction on a typical lead vocal."
    },
    {
      "id": "opto_gain",
      "upstream_id": "opto_gain",
      "name": "Opto Gain",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 23.409226,
      "unit": "%",
      "ai_hint": "Opto only. Output gain knob; 23.4 is unity (0 dB), 32 is about +5.6 dB, 41 about +11 dB."
    },
    {
      "id": "fet_input",
      "upstream_id": "fet_input",
      "name": "FET Input",
      "type": "float",
      "min": -20,
      "max": 40,
      "default": 0,
      "unit": "dB",
      "ai_hint": "FET and Studio FET. Drive into the compressor."
    },
    {
      "id": "fet_threshold",
      "upstream_id": "fet_threshold",
      "name": "FET Threshold",
      "type": "float",
      "min": -60,
      "max": 0,
      "default": -10,
      "unit": "dB",
      "ai_hint": "FET and Studio FET. Where compression starts."
    },
    {
      "id": "fet_ratio",
      "upstream_id": "fet_ratio",
      "name": "FET Ratio",
      "type": "enum",
      "default": "4:1",
      "options": [
        "4:1",
        "8:1",
        "12:1",
        "20:1",
        "All"
      ],
      "convert": "enum_index",
      "ai_hint": "FET and Studio FET. 4:1 for vocals; All only for extreme room-mic smash."
    },
    {
      "id": "fet_attack",
      "upstream_id": "fet_attack",
      "name": "FET Attack",
      "type": "float",
      "min": 0.02,
      "max": 80,
      "default": 0.2,
      "unit": "ms",
      "scale": "log",
      "ai_hint": "FET and Studio FET. Under 1 ms for presence; slower to keep transients."
    },
    {
      "id": "fet_release",
      "upstream_id": "fet_release",
      "name": "FET Release",
      "type": "float",
      "min": 50,
      "max": 1100,
      "default": 400,
      "unit": "ms",
      "ai_hint": "FET and Studio FET."
    },
    {
      "id": "fet_output",
      "upstream_id": "fet_output",
      "name": "FET Output",
      "type": "float",
      "min": -20,
      "max": 20,
      "default": 0,
      "unit": "dB",
      "ai_hint": "FET and Studio FET. Output trim."
    },
    {
      "id": "fet_transient",
      "upstream_id": "fet_transient",
      "name": "FET Transient",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 0,
      "unit": "%",
      "ai_hint": "FET and Studio FET. Blends raw transients past the compressor."
    },
    {
      "id": "vca_threshold",
      "upstream_id": "vca_threshold",
      "name": "VCA Threshold",
      "type": "float",
      "min": -55.0,
      "max": 0.0,
      "default": -27.0,
      "unit": "dB",
      "ai_hint": "VCA only."
    },
    {
      "id": "vca_compression",
      "upstream_id": "vca_compression",
      "name": "VCA Compression",
      "type": "float",
      "min": 0,
      "max": 95,
      "default": 50.4944,
      "unit": "%",
      "ai_hint": "VCA only. Compression knob: 0 = 1:1, about 50 = moderate, 80+ heavy. Above 95 over-compresses, so it is capped."
    },
    {
      "id": "vca_output",
      "upstream_id": "vca_output",
      "name": "VCA Output",
      "type": "float",
      "min": -20,
      "max": 20,
      "default": 0,
      "unit": "dB",
      "ai_hint": "VCA only."
    },
    {
      "id": "bus_threshold",
      "upstream_id": "bus_threshold",
      "name": "Bus Threshold",
      "type": "float",
      "min": -30,
      "max": 15,
      "default": 0,
      "unit": "dB",
      "ai_hint": "Bus only. Aim for 1-4 dB of gain reduction for glue."
    },
    {
      "id": "bus_ratio",
      "upstream_id": "bus_ratio",
      "name": "Bus Ratio",
      "type": "enum",
      "default": "2:1",
      "options": [
        "2:1",
        "4:1",
        "10:1"
      ],
      "convert": "enum_index",
      "ai_hint": "Bus only. 2:1 subtle, 4:1 classic drum glue."
    },
    {
      "id": "bus_attack",
      "upstream_id": "bus_attack",
      "name": "Bus Attack",
      "type": "enum",
      "default": "1ms",
      "options": [
        "0.1ms",
        "0.3ms",
        "1ms",
        "3ms",
        "10ms",
        "30ms"
      ],
      "convert": "enum_index",
      "ai_hint": "Bus only. 30ms lets drum transients punch through."
    },
    {
      "id": "bus_release",
      "upstream_id": "bus_release",
      "name": "Bus Release",
      "type": "enum",
      "default": "0.3s",
      "options": [
        "0.1s",
        "0.3s",
        "0.6s",
        "1.2s",
        "Auto"
      ],
      "convert": "enum_index",
      "ai_hint": "Bus only. Auto is the classic glue setting."
    },
    {
      "id": "bus_makeup",
      "upstream_id": "bus_makeup",
      "name": "Bus Makeup",
      "type": "float",
      "min": 0,
      "max": 20,
      "default": 0,
      "unit": "dB",
      "ai_hint": "Bus only."
    },
    {
      "id": "studio_vca_threshold",
      "upstream_id": "studio_vca_threshold",
      "name": "Studio VCA Threshold",
      "type": "float",
      "min": -50,
      "max": 20,
      "default": -10,
      "unit": "dB",
      "ai_hint": "Studio VCA only."
    },
    {
      "id": "studio_vca_ratio",
      "upstream_id": "studio_vca_ratio",
      "name": "Studio VCA Ratio",
      "type": "float",
      "min": 1,
      "max": 20,
      "default": 1.5,
      "unit": ":1",
      "ai_hint": "Studio VCA only. Capped at 20:1 here (upstream allows 50:1)."
    },
    {
      "id": "studio_vca_attack",
      "upstream_id": "studio_vca_attack",
      "name": "Studio VCA Attack",
      "type": "float",
      "min": 0.1805,
      "max": 75,
      "default": 7.2305,
      "unit": "ms",
      "ai_hint": "Studio VCA only."
    },
    {
      "id": "studio_vca_release",
      "upstream_id": "studio_vca_release",
      "name": "Studio VCA Release",
      "type": "float",
      "min": 100,
      "max": 4000,
      "default": 1000,
      "unit": "ms",
      "ai_hint": "Studio VCA only."
    },
    {
      "id": "studio_vca_output",
      "upstream_id": "studio_vca_output",
      "name": "Studio VCA Make Up",
      "type": "float",
      "min": -20,
      "max": 20,
      "default": 0,
      "unit": "dB",
      "ai_hint": "Studio VCA only."
    },
    {
      "id": "digital_threshold",
      "upstream_id": "digital_threshold",
      "name": "Digital Threshold",
      "type": "float",
      "min": -60,
      "max": 0,
      "default": -20,
      "unit": "dB",
      "ai_hint": "Digital only."
    },
    {
      "id": "digital_ratio",
      "upstream_id": "digital_ratio",
      "name": "Digital Ratio",
      "type": "float",
      "min": 1,
      "max": 20,
      "default": 4,
      "unit": ":1",
      "scale": "log",
      "ai_hint": "Digital only. Capped at 20:1 here."
    },
    {
      "id": "digital_knee",
      "upstream_id": "digital_knee",
      "name": "Digital Knee",
      "type": "float",
      "min": 0,
      "max": 20,
      "default": 6,
      "unit": "dB",
      "ai_hint": "Digital only. 6 dB is a soft, musical knee."
    },
    {
      "id": "digital_attack",
      "upstream_id": "digital_attack",
      "name": "Digital Attack",
      "type": "float",
      "min": 0.01,
      "max": 500,
      "default": 10,
      "unit": "ms",
      "scale": "log",
      "ai_hint": "Digital only."
    },
    {
      "id": "digital_release",
      "upstream_id": "digital_release",
      "name": "Digital Release",
      "type": "float",
      "min": 1,
      "max": 5000,
      "default": 100,
      "unit": "ms",
      "scale": "log",
      "ai_hint": "Digital only."
    },
    {
      "id": "digital_output",
      "upstream_id": "digital_output",
      "name": "Digital Output",
      "type": "float",
      "min": -24,
      "max": 24,
      "default": 0,
      "unit": "dB",
      "ai_hint": "Digital only."
    }
  ],
  "hidden_params": {
    "count": 26,
    "reason": "Multiband mode, sidechain EQ, external sidechain, lookahead, distortion, link modes and meters stay at defaults; multiband needs its own catalogue entry."
  },
  "notes": [
    "Parameters come from the DAF build's descriptor table, which drives the framework-free MultiCompDSP core Plugsalot embeds. The older JUCE layout differs (e.g. Opto gain unity point, VCA controls).",
    "VCA attack, release, over-easy and detector are inert in the current core and are excluded.",
    "Starting points and hints are drawn from the Dusk Audio Multi-Comp manual (manuals/multi-comp.md) and core source comments.",
    "Each mode has its own threshold scale, so switching mode means re-setting the compression amount.",
    "CPU: 3.70% of one core at 48 kHz on Plugsalot's 2-core build machine (plugin/tests/TestMain.cpp); 1 point per 2%, minimum 1."
  ]
}
