{
  "schema_version": 1,
  "id": "multicomp",
  "name": "Multi-Comp",
  "kind": "effect",
  "category": "dynamics",
  "source": {
    "source_key": "dusk-audio",
    "repo": "https://github.com/dusk-audio/dusk-audio-plugins",
    "commit": "e0991c57cac4f8f666b5749dcb90dcbd9081cd30",
    "path": "plugins/multi-comp",
    "upstream_name": "Dusk Audio Multi-Comp",
    "license": "GPL-3.0-or-later",
    "authors": "Dusk Audio",
    "extractor": "dusk_table"
  },
  "purpose": "Compressor with seven hardware-style modes (opto, FET, VCA, bus, studio FET, studio VCA, digital) for levelling vocals, adding punch to drums and gluing buses.",
  "good_for": [
    "lead vocal",
    "backing vocal",
    "bass",
    "kick",
    "snare",
    "full kit",
    "software drums",
    "acoustic guitar",
    "electric guitar",
    "bus"
  ],
  "tags": [
    "compression",
    "glue",
    "punch",
    "levelling",
    "saturation"
  ],
  "cpu_points": 2,
  "cpu_measured": true,
  "latency": {
    "type": "variable",
    "note": "About 1.5 ms of anti-aliasing delay in every mode (kept constant so hosts don't re-sync when the mode changes); lookahead adds more. Acceptable for tracking."
  },
  "tracking_safe": true,
  "tracking_overrides": {
    "oversampling": "Off"
  },
  "channels": [
    "mono",
    "stereo"
  ],
  "maker": "Dusk Audio",
  "tape": "EVENS OUT THE LEVEL",
  "knobs": [
    {
      "param": "mix",
      "label": "MIX",
      "colour": "cream"
    }
  ],
  "knobs_by_mode": {
    "param": "mode",
    "modes": {
