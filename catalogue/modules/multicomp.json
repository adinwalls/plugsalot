{
  "schema_version": 1,
  "id": "multicomp",
  "name": "Multi-Comp",
  "kind": "effect",
  "category": "dynamics",
  "source": {
    "source_key": "dusk-audio",
    "repo": "https://github.com/dusk-audio/dusk-audio-plugins",
    "commit": "e0991c57cac4f8f666b5749dcb90dcbd9081cd30",
    "path": "plugins/multi-comp/multicomp.cpp",
    "upstream_name": "Dusk Audio Multi-Comp",
    "license": "GPL-3.0-or-later",
    "authors": "Dusk Audio",
    "extractor": "juce_apvts"
  },
  "purpose": "Compressor with seven hardware-style modes (opto, FET, VCA, bus, studio, digital) for levelling vocals, adding punch to drums and gluing buses.",
  "good_for": [
    "lead vocal",
    "backing vocal",
    "bass",
    "kick",
    "snare",
    "full kit",
    "software drums",
    "acoustic guitar",
    "electric guitar",
    "bus"
  ],
  "tags": [
    "compression",
    "glue",
    "punch",
    "levelling",
    "saturation"
  ],
  "cpu_points": null,
  "cpu_measured": false,
  "latency": {
    "type": "variable",
    "note": "Oversampling and lookahead add latency."
  },
  "tracking_safe": true,
  "tracking_overrides": {
    "oversampling": "Off"
  },
  "channels": [
    "mono",
    "stereo"
  ],
  "params": [
    {
      "id": "mode",
      "upstream_id": "mode",
      "name": "Mode",
      "type": "enum",
      "default": "Vintage Opto",
      "options": [
        "Vintage Opto",
        "Vintage FET",
        "Classic VCA",
        "Vintage VCA (Bus)",
        "Studio FET",
        "Studio VCA",
        "Digital"
      ],
      "convert": "enum_index",
      "ai_hint": "Opto: smooth vocal levelling. Vintage FET: aggressive, forward vocals and drums. Bus: drum and mix glue. Studio modes: cleaner. Digital: precise. Set only the parameters of the chosen mode."
    },
    {
      "id": "mix",
      "upstream_id": "mix",
      "name": "Mix",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 100.0,
      "unit": "%",
      "ai_hint": "Below 100% for parallel compression."
    },
    {
      "id": "sidechain_hp",
      "upstream_id": "sidechain_hp",
      "name": "SC HP Filter",
      "type": "float",
      "min": 0.0,
      "max": 500.0,
      "default": 0.0,
      "unit": "Hz",
      "scale": "log",
      "ai_hint": "60-100 Hz stops low end from pumping the compressor; 0 = off."
    },
    {
      "id": "auto_makeup",
      "upstream_id": "auto_makeup",
      "name": "Auto Makeup",
      "type": "enum",
      "default": "Off",
      "options": [
        "Off",
        "On"
      ],
      "convert": "enum_index",
      "ai_hint": "On to keep output level matched while adjusting compression."
    },
    {
      "id": "oversampling",
      "upstream_id": "oversampling",
      "name": "Oversampling",
      "type": "enum",
      "default": "2x",
      "options": [
        "Off",
        "2x",
        "4x"
      ],
      "convert": "enum_index",
      "ai_hint": "2x default. Off when tracking. 4x only on a final bus."
    },
    {
      "id": "opto_peak_reduction",
      "upstream_id": "opto_peak_reduction",
      "name": "Peak Reduction",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 0.0,
      "unit": "%",
      "ai_hint": "Vintage Opto only. Compression amount; 50% gives roughly 4-6 dB reduction on a typical lead vocal."
    },
    {
      "id": "opto_gain",
      "upstream_id": "opto_gain",
      "name": "Gain",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 50.0,
      "unit": "%",
      "ai_hint": "Vintage Opto only. Output gain; 50% is unity."
    },
    {
      "id": "fet_input",
      "upstream_id": "fet_input",
      "name": "Input",
      "type": "float",
      "min": -20.0,
      "max": 40.0,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Vintage/Studio FET. Drive into the compressor."
    },
    {
      "id": "fet_threshold",
      "upstream_id": "fet_threshold",
      "name": "Threshold",
      "type": "float",
      "min": -60.0,
      "max": 0.0,
      "default": -10.0,
      "unit": "dB",
      "ai_hint": "Vintage/Studio FET. Where compression starts."
    },
    {
      "id": "fet_ratio",
      "upstream_id": "fet_ratio",
      "name": "Ratio",
      "type": "enum",
      "default": "4:1",
      "options": [
        "4:1",
        "8:1",
        "12:1",
        "20:1",
        "All"
      ],
      "convert": "enum_index",
      "ai_hint": "Vintage/Studio FET. 4:1 for vocals; All for extreme room-mic smash only."
    },
    {
      "id": "fet_attack",
      "upstream_id": "fet_attack",
      "name": "Attack",
      "type": "float",
      "min": 0.02,
      "max": 80.0,
      "default": 0.2,
      "unit": "ms",
      "scale": "log",
      "ai_hint": "Vintage/Studio FET. Fast (under 1 ms) for presence; slower to keep transients."
    },
    {
      "id": "fet_release",
      "upstream_id": "fet_release",
      "name": "Release",
      "type": "float",
      "min": 50.0,
      "max": 1100.0,
      "default": 400.0,
      "unit": "ms",
      "ai_hint": "Vintage/Studio FET."
    },
    {
      "id": "fet_output",
      "upstream_id": "fet_output",
      "name": "Output",
      "type": "float",
      "min": -20.0,
      "max": 20.0,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Vintage/Studio FET. Output trim."
    },
    {
      "id": "fet_transient",
      "upstream_id": "fet_transient",
      "name": "Transient",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 0.0,
      "unit": "%",
      "ai_hint": "Vintage/Studio FET. Blends raw transients past the compressor."
    },
    {
      "id": "vca_threshold",
      "upstream_id": "vca_threshold",
      "name": "Threshold",
      "type": "float",
      "min": -38.0,
      "max": 12.0,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Classic VCA only."
    },
    {
      "id": "vca_ratio",
      "upstream_id": "vca_ratio",
      "name": "Ratio",
      "type": "float",
      "min": 1.0,
      "max": 20,
      "default": 4.0,
      "unit": ":1",
      "scale": "log",
      "ai_hint": "Classic VCA only. Upstream allows up to 120:1 (limiting); capped at 20:1 here."
    },
    {
      "id": "vca_attack",
      "upstream_id": "vca_attack",
      "name": "Attack",
      "type": "float",
      "min": 0.1,
      "max": 50.0,
      "default": 1.0,
      "unit": "ms",
      "ai_hint": "Classic VCA only."
    },
    {
      "id": "vca_release",
      "upstream_id": "vca_release",
      "name": "Release",
      "type": "float",
      "min": 10.0,
      "max": 5000.0,
      "default": 100.0,
      "unit": "ms",
      "ai_hint": "Classic VCA only."
    },
    {
      "id": "vca_output",
      "upstream_id": "vca_output",
      "name": "Output",
      "type": "float",
      "min": -20.0,
      "max": 20.0,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Classic VCA only."
    },
    {
      "id": "bus_threshold",
      "upstream_id": "bus_threshold",
      "name": "Threshold",
      "type": "float",
      "min": -30.0,
      "max": 15.0,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Vintage VCA (Bus) only. Aim for 1-4 dB of gain reduction for glue."
    },
    {
      "id": "bus_ratio",
      "upstream_id": "bus_ratio",
      "name": "Ratio",
      "type": "enum",
      "default": "2:1",
      "options": [
        "2:1",
        "4:1",
        "10:1"
      ],
      "convert": "enum_index",
      "ai_hint": "Vintage VCA (Bus) only. 2:1 subtle, 4:1 classic drum glue."
    },
    {
      "id": "bus_attack",
      "upstream_id": "bus_attack",
      "name": "Attack",
      "type": "enum",
      "default": "1ms",
      "options": [
        "0.1ms",
        "0.3ms",
        "1ms",
        "3ms",
        "10ms",
        "30ms"
      ],
      "convert": "enum_index",
      "ai_hint": "Vintage VCA (Bus) only. 30ms lets drum transients punch through."
    },
    {
      "id": "bus_release",
      "upstream_id": "bus_release",
      "name": "Release",
      "type": "enum",
      "default": "0.3s",
      "options": [
        "0.1s",
        "0.3s",
        "0.6s",
        "1.2s",
        "Auto"
      ],
      "convert": "enum_index",
      "ai_hint": "Vintage VCA (Bus) only. Auto is the classic glue setting."
    },
    {
      "id": "bus_makeup",
      "upstream_id": "bus_makeup",
      "name": "Makeup",
      "type": "float",
      "min": 0.0,
      "max": 20.0,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Vintage VCA (Bus) only."
    },
    {
      "id": "studio_vca_threshold",
      "upstream_id": "studio_vca_threshold",
      "name": "Threshold",
      "type": "float",
      "min": -40.0,
      "max": 20.0,
      "default": -10.0,
      "unit": "dB",
      "ai_hint": "Studio VCA only."
    },
    {
      "id": "studio_vca_ratio",
      "upstream_id": "studio_vca_ratio",
      "name": "Ratio",
      "type": "float",
      "min": 1.0,
      "max": 10.0,
      "default": 3.0,
      "unit": ":1",
      "ai_hint": "Studio VCA only."
    },
    {
      "id": "studio_vca_attack",
      "upstream_id": "studio_vca_attack",
      "name": "Attack",
      "type": "float",
      "min": 0.3,
      "max": 75.0,
      "default": 10.0,
      "unit": "ms",
      "ai_hint": "Studio VCA only."
    },
    {
      "id": "studio_vca_release",
      "upstream_id": "studio_vca_release",
      "name": "Release",
      "type": "float",
      "min": 100.0,
      "max": 4000.0,
      "default": 300.0,
      "unit": "ms",
      "ai_hint": "Studio VCA only."
    },
    {
      "id": "studio_vca_output",
      "upstream_id": "studio_vca_output",
      "name": "Output",
      "type": "float",
      "min": -20.0,
      "max": 20.0,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Studio VCA only."
    },
    {
      "id": "digital_threshold",
      "upstream_id": "digital_threshold",
      "name": "Threshold",
      "type": "float",
      "min": -60.0,
      "max": 0.0,
      "default": -20.0,
      "unit": "dB",
      "ai_hint": "Digital only."
    },
    {
      "id": "digital_ratio",
      "upstream_id": "digital_ratio",
      "name": "Ratio",
      "type": "float",
      "min": 1.0,
      "max": 20,
      "default": 4.0,
      "unit": ":1",
      "scale": "log",
      "ai_hint": "Digital only. Capped at 20:1 here."
    },
    {
      "id": "digital_knee",
      "upstream_id": "digital_knee",
      "name": "Knee",
      "type": "float",
      "min": 0.0,
      "max": 20.0,
      "default": 6.0,
      "unit": "dB",
      "ai_hint": "Digital only. 6 dB is a soft, musical knee."
    },
    {
      "id": "digital_attack",
      "upstream_id": "digital_attack",
      "name": "Attack",
      "type": "float",
      "min": 0.01,
      "max": 500.0,
      "default": 10.0,
      "unit": "ms",
      "scale": "log",
      "ai_hint": "Digital only."
    },
    {
      "id": "digital_release",
      "upstream_id": "digital_release",
      "name": "Release",
      "type": "float",
      "min": 1.0,
      "max": 5000.0,
      "default": 100.0,
      "unit": "ms",
      "scale": "log",
      "ai_hint": "Digital only."
    },
    {
      "id": "digital_output",
      "upstream_id": "digital_output",
      "name": "Output",
      "type": "float",
      "min": -24.0,
      "max": 24.0,
      "default": 0.0,
      "unit": "dB",
      "ai_hint": "Digital only."
    }
  ],
  "hidden_params": {
    "count": 40,
    "reason": "Multiband mode, sidechain EQ, external sidechain, lookahead, distortion, link modes and meters stay at defaults for now; multiband needs its own catalogue entry."
  },
  "notes": [
    "Starting points and hints are drawn from the Dusk Audio Multi-Comp manual (manuals/multi-comp.md).",
    "Several thresholds and times have no unit label in code; units here follow the manual.",
    "Each mode has its own threshold scale, so switching mode means re-setting the compression amount."
  ]
}
