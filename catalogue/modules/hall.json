{
  "schema_version": 1,
  "id": "hall",
  "name": "Hall Reverb",
  "kind": "effect",
  "category": "reverb",
  "source": {
    "source_key": "dragonfly-reverb",
    "repo": "https://github.com/michaelwillis/dragonfly-reverb",
    "commit": "440ec7b3b3db2fec34b9f80cf4890102ca14d1c3",
    "path": "plugins/dragonfly-hall-reverb",
    "upstream_name": "Dragonfly Hall Reverb",
    "license": "GPL-3.0",
    "authors": "Michael Willis and contributors",
    "extractor": "dpf_param_table"
  },
  "purpose": "Concert-hall reverb with early reflections and a long, smooth, modulated tail; for big, spacious, expansive vocals, pads and ballads.",
  "good_for": [
    "lead vocal",
    "backing vocal",
    "acoustic guitar",
    "keys",
    "synth",
    "pad",
    "strings",
    "snare"
  ],
  "avoid_for": [
    "bass",
    "kick"
  ],
  "tags": [
    "ambience",
    "space",
    "hall",
    "spacious",
    "expansive",
    "vocal reverb",
    "long tail"
  ],
  "cpu_points": 1,
  "cpu_measured": true,
  "latency": {
    "type": "none"
  },
  "tracking_safe": true,
  "channels": [
    "stereo"
  ],
  "maker": "Dragonfly",
  "tape": "BIG OPEN SPACE",
  "knobs": [
    {
      "param": "decay",
      "label": "DECAY",
      "colour": "cream"
    },
    {
      "param": "size",
      "label": "SIZE",
      "colour": "cream"
    },
    {
      "param": "predelay",
      "label": "PRE-DLY",
      "colour": "cream"
    },
    {
      "param": "high_cut",
      "label": "HI CUT",
      "colour": "black"
    },
    {
      "param": "wet",
      "label": "MIX",
      "colour": "cream"
    }
  ],
  "params": [
    {
      "id": "dry",
      "upstream_id": "dry_level",
      "name": "Dry Level",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 80.0,
      "unit": "%",
      "ai_hint": "Dry signal level. Keep at 100% when used as an insert."
    },
    {
      "id": "early",
      "upstream_id": "early_level",
      "name": "Early Level",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 10.0,
      "unit": "%",
      "ai_hint": "Early reflections level: the sense of walls close by. 5-15%."
    },
    {
      "id": "wet",
      "upstream_id": "late_level",
      "name": "Late Level",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 20.0,
      "unit": "%",
      "ai_hint": "Reverb tail level. 10-20% for a vocal; 25%+ for an obviously big hall."
    },
    {
      "id": "size",
      "upstream_id": "size",
      "name": "Size",
      "type": "float",
      "min": 10.0,
      "max": 60.0,
      "default": 24.0,
      "unit": "m",
      "ai_hint": "Hall size in metres. 15-25 small hall, 30-40 concert hall, 50+ cathedral scale."
    },
    {
      "id": "width",
      "upstream_id": "width",
      "name": "Width",
      "type": "float",
      "min": 50.0,
      "max": 150.0,
      "default": 100.0,
      "unit": "%",
      "ai_hint": "Stereo width of the reverb. Above 100% is wider than natural."
    },
    {
      "id": "predelay",
      "upstream_id": "delay",
      "name": "Predelay",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 4.0,
      "unit": "ms",
      "ai_hint": "30-60 ms keeps a vocal clear in front of a long tail."
    },
    {
      "id": "decay",
      "upstream_id": "decay",
      "name": "Decay",
      "type": "float",
      "min": 0.1,
      "max": 10.0,
      "default": 1.3,
      "unit": "s",
      "ai_hint": "Tail length in seconds. 1.5-2.5 s for a vocal hall, 3-5 s for huge, slow, expansive sounds."
    },
    {
      "id": "diffuse",
      "upstream_id": "diffuse",
      "name": "Diffuse",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 90.0,
      "unit": "%",
      "ai_hint": "Density of the tail. 70-90% is smooth for vocals; lower is grainier."
    },
    {
      "id": "low_cut",
      "upstream_id": "low_cut",
      "name": "Low Cut",
      "type": "float",
      "min": 0.0,
      "max": 200.0,
      "default": 4.0,
      "unit": "Hz",
      "ai_hint": "Raise towards 150-200 Hz to keep the reverb out of the low end."
    },
    {
      "id": "high_cut",
      "upstream_id": "high_cut",
      "name": "High Cut",
      "type": "float",
      "min": 1000.0,
      "max": 16000.0,
      "default": 7600,
      "unit": "Hz",
      "ai_hint": "Lower to 6000-9000 Hz to darken the tail and reduce sibilant splash."
    },
    {
      "id": "modulation",
      "upstream_id": "modulation",
      "name": "Modulation",
      "type": "float",
      "min": 0.0,
      "max": 100.0,
      "default": 15.0,
      "unit": "%",
      "ai_hint": "Movement in the tail. 15-30% adds lushness; high values can sound chorused."
    }
  ],
  "hidden_params": {
    "count": 7
  },
